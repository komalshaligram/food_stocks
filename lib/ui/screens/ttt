try {
            // 1. Prepare new stock list
            final res = await DioClient(event.context).post(
              AppUrlEndPoints.getSaleProductsUrl,
              data: const ProductSalesReqModel(pageNum: 1, pageLimit: AppConstants.defaultPageLimit).toJson(),
            );
            ProductSalesResModel response = ProductSalesResModel.fromJson(res);

            if (response.status != AppConstants.code_200) {
              throw Exception("Sale list failed");
            }

            List<ProductSale> saleList = response.data ?? [];
            List<ProductStockModel> newStockList = saleList.map((saleProduct) {
              return ProductStockModel(
                maxQty: (saleProduct.sale?.isSale ?? false)
                    ? int.tryParse(saleProduct.sale?.saleMaxQuantity ?? '0') ?? 0
                    : 0,
                productId: saleProduct.id ?? '',
                stock: saleProduct.productStock.toString(),
                quantity: 0,
              );
            }).toList();

            // 2. Fetch cart and sync quantities
            try {
              final cartRes = await DioClient(event.context).post(
                '${AppUrlEndPoints.getAllCartUrl}${preferences.getCartId()}',
              );
              GetAllCartResModel cartResponse = GetAllCartResModel.fromJson(cartRes);

              if (cartResponse.status == AppConstants.code_200) {
                final cartItems = cartResponse.data?.data ?? [];
                for (int i = 0; i < newStockList.length; i++) {
                  final stockItem = newStockList[i];
                  final match = cartItems.firstWhere(
                        (c) => c.id == stockItem.productId,
                  );
                  if (match != null) {
                    newStockList[i] = stockItem.copyWith(quantity: match.totalQuantity ?? 0);
                  }
                }
              }
            } catch (_) {
              // fallback, keep quantities as 0
            }

            // 3. Emit complete, final state once
            final updatedStockLists = state.productStockList.toList(growable: true);
            updatedStockLists[3] = newStockList;

            emit(state.copyWith(
              productSalesList: saleList,
              productStockList: updatedStockLists,
              isProductSaleShimmering: false,
              allShimmering: false,
            ));

           add(HomeEvent.getRecommendationProductsListEvent(context: event.context));

          } catch (e) {
            emit(state.copyWith(
              isProductSaleShimmering: false,
              allShimmering: false,
            ));
            add(HomeEvent.getRecommendationProductsListEvent(context: event.context));
          }